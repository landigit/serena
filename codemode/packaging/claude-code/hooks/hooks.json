{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read",
        "hooks": [{ "type": "command", "command": "codemode hook pre-tool" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "codemode hook post-tool" }]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [{ "type": "command", "command": "codemode hook session-start" }]
      }
    ],
    "PreCompact": [
      {
        "hooks": [{ "type": "command", "command": "codemode hook pre-compact" }]
      }
    ]
  }
}
